menu "E-ink display"

    # The panel choice is NOT here. It is a plain #define in
    # components/eink/include/eink_panel.h - one line, no menuconfig.

    config EINK_SPI_CLOCK_HZ
        int "SPI clock (Hz)"
        default 10000000
        range 1000000 20000000
        help
            10 MHz is what both vendor drivers use. Lower it if the FPC run to
            CON1 turns out to be marginal.

    config EINK_FULL_REFRESH_INTERVAL
        int "Partial refreshes between full refreshes"
        default 12
        range 0 100
        help
            Partial refreshes are fast and quiet but leave ghosting behind. A
            full refresh clears it and costs a visible flash plus several
            seconds. 0 forces every refresh to be a full one. Ignored on the
            four-colour panel, which has no partial mode.

    config JD79660_FAST_MODE
        bool "Four-colour panel: use the fast refresh waveform"
        default y
        help
            Cuts a full four-colour refresh from roughly 30 s to roughly 21 s,
            at the cost of the low end of the panel temperature range. Turn it
            off for a unit that has to update while it is near freezing.

endmenu
