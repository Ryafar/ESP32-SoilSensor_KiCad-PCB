menu "Soil Sensor Configuration"

    orsource "$IDF_PATH/examples/common_components/env_caps/$IDF_TARGET/Kconfig.env_caps"

    config SOILSENSOR_STATUS_LED_GPIO
        int "Status LED GPIO number"
        range ENV_GPIO_RANGE_MIN ENV_GPIO_OUT_RANGE_MAX
        default 8
        help
            GPIO the addressable status LED (WS2812) of the sensor board is
            connected to.

    config SOILSENSOR_STATUS_LED_BRIGHTNESS
        int "Status LED brightness (0-255 per color channel)"
        range 0 255
        default 16
        help
            Value written to each RGB channel when the status LED is on.
            The LED is bright, low values are plenty.

    config SOILSENSOR_HEARTBEAT_PERIOD_MS
        int "Status LED heartbeat period in ms"
        range 10 3600000
        default 1000
        help
            Toggle period of the status LED heartbeat.

endmenu
