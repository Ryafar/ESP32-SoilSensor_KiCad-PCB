/* Template for main/secrets.h - copy it, fill it in, and never commit the copy.
 *
 *     cp main/secrets.h.example main/secrets.h
 *
 * `main/secrets.h` is gitignored. The build fails with a message pointing here
 * if it is missing, rather than compiling a firmware that cannot reach the
 * network and only says so in the log.
 *
 * Not Kconfig: that would put the password into the generated `sdkconfig`,
 * which is gitignored too, so the secret would live in a file nobody thinks of
 * as secret. One file whose whole purpose is to be untracked is easier to
 * reason about.
 */
#pragma once

/* 2.4 GHz only - the ESP32-C6's WiFi radio does not do 5 GHz. A network that is
 * 5 GHz only is the most common reason a board that scans fine never
 * associates. */
#define SECRET_WIFI_SSID     "your-ssid"
#define SECRET_WIFI_PASSWORD "your-password"

/* Broker URI with scheme and port, e.g. "mqtt://192.168.1.10:1883". An IP
 * rather than a hostname avoids depending on DNS for the first bring-up. */
#define SECRET_MQTT_URI      "mqtt://192.168.1.10:1883"

/* Empty strings mean anonymous access, which Mosquitto only allows if it is
 * configured for it. */
#define SECRET_MQTT_USERNAME ""
#define SECRET_MQTT_PASSWORD ""
