# Project defaults. Delete sdkconfig and re-run `idf.py build` to apply changes.
CONFIG_IDF_TARGET="esp32c6"

# ESP32-C6-FH4 carries 4 MB of flash.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Console over native USB-Serial-JTAG (GPIO12/13), not UART. The board routes no
# UART off-chip, and leaving the UART console enabled would drive GPIO16/17 -
# GPIO16 is BAT_MEAS_EN here, so the console would fight the battery divider
# enable. See docs/hardware/README.md §2.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# The panel choice is not a Kconfig symbol. It is a #define in
# components/eink/include/eink_panel.h - change it there and rebuild.

# WiFi + MQTT + mbedTLS do not fit the default 1 MB app partition: the
# application image is ~1.1 MB. The large single-app layout gives the factory
# partition 1.5 MB, which the 4 MB flash has room for several times over. No
# OTA partitions - there is no update path on this board, and two app slots
# would cost more than they buy.
#
# NVS stays at 0x9000 with the same size in this layout, so the WiFi driver's RF
# calibration data survives the change.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# With deep sleep there is no long-running task: app_main runs the whole
# measurement sequence - drivers, the e-paper init sequence, the MQTT publish -
# and then sleeps. The IDF default of 3584 bytes was sized for an app_main that
# only starts tasks and returns, and it overflowed on the first publish (the
# stack protector caught it). 8 kB is what the measure task used to have.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
